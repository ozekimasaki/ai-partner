# ===== 必須 =====
# Model Studio のシンガポールで作った APIキー
DASHSCOPE_API_KEY=

# シンガポールのワークスペースID（llm-xxx のような形）。
# 入れると https://{ID}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1 を使います。
# 空のときは https://dashscope-intl.aliyuncs.com/compatible-mode/v1 を使います。
DASHSCOPE_WORKSPACE_ID=

# ===== 好みで変える =====
# 役を演じるモデル。既定は日本語向けの qwen-plus-character-ja（コンテキストは 8,192 と短め）。
# 長い会話や記憶を足すなら qwen-plus-character（シンガポールで 131,072）
PARTNER_MODEL=qwen-plus-character-ja
# パートナーの設定フォルダ（partner.md / partner.png / partner_voice.txt を置く）
PARTNER_DIR=partner
# 画面に出す名前。空なら partner.md の「# 人物」の最初の一文から取ります
PARTNER_NAME=
# あなたの呼び名（記憶に書くときの name に使います）
USER_NAME=あなた
# モデルへ渡す直近の往復数
HISTORY_TURNS=10
# Base URL を丸ごと指定したいとき（手元の transformers serve など）。入れるとワークスペースIDより優先
DASHSCOPE_BASE_URL=

# ===== 任意: 記憶（ReMe）=====
# reme start で起動した ReMe のアドレス。空なら記憶は無効
REME_URL=

# ===== 任意: 声（北京のボイスデザイン）=====
# 北京で作った APIキーとワークスペースID。両方そろうと声が有効になります
DASHSCOPE_API_KEY_BEIJING=
DASHSCOPE_WORKSPACE_ID_BEIJING=
PARTNER_VOICE_MODEL=qwen-audio-3.1-tts-flash
# 一度作った声の voice_id（空なら初回に作って partner/.voice_id に保存します）
PARTNER_VOICE_ID=
